<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>OnDevice LLM</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>3.5.6</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.mesutcydev.ioslocalllm.scheme</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ios-local-llm</string>
				<string>codelens</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSBonjourServices</key>
	<array>
		<string>_localllm._tcp</string>
	</array>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>OnDevice LLM reads your calendar only when you approve an assistant request to look at your schedule. Events stay on your device.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>OnDevice LLM adds an event to your calendar only when you approve an assistant request.</string>
	<key>NSCameraUsageDescription</key>
	<string>OnDevice LLM uses the camera to recognize text and analyze images locally in Lens.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>OnDevice LLM connects to your paired Mac and lets trusted computers use your local models when you enable the Mac Bridge or Local API Server.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>OnDevice LLM uses the microphone for dictation and voice conversations. Speech is transcribed on your device.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>OnDevice LLM lets you choose photos to analyze locally or attach to a conversation.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>OnDevice LLM adds a reminder only when you approve an assistant request.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>OnDevice LLM uses on-device speech recognition to turn your voice into text for dictation and voice conversations.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIRequiresFullScreen</key>
	<false/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDarkContent</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
